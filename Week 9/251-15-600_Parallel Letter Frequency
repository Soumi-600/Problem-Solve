
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

public class ParallelLetterFrequency {

    public Map<Character, Integer> countLetters(List<String> texts) {

        Map<Character, Integer> frequency = new ConcurrentHashMap<>();

        texts.parallelStream()
             .forEach(text -> {
                 for (char ch : text.toLowerCase().toCharArray()) {
                     if (Character.isLetter(ch)) {
                         frequency.merge(ch, 1, Integer::sum);
                     }
                 }
             });

        return frequency;
    }
}
